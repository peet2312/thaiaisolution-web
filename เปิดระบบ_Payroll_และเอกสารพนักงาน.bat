@echo off
chcp 65001 > nul
title ระบบ Payroll & เอกสารพนักงาน — บริษัท ไทยเอไอ โซลูชั่น จำกัด

echo =====================================================================
echo    บริษัท ไทยเอไอ โซลูชั่น จำกัด (THAI AI SOLUTION CO., LTD.)
echo    ระบบ Payroll, ใบรับเงินเดือน (Pay Slip) และ หนังสือรับรองการทำงาน
echo =====================================================================
echo.
echo [1] เปิดโฟลเดอร์เอกสารที่ออกให้พนักงาน (PDF ^& HTML)
echo [2] เปิดดูหนังสือรับรองการทำงาน (ภาษาไทย) ในเบราว์เซอร์
echo [3] เปิดดูสลิปเงินเดือน (Pay Slip) ในเบราว์เซอร์
echo [4] เริ่มต้นเว็บแอป Payroll System (http://localhost:3001)
echo [5] ออกจากโปรแกรม
echo.
set /p choice="กรุณาเลือกเมนู [1-5]: "

if "%choice%"=="1" (
    start "" "%~dp0เอกสารพนักงาน"
    exit /b
)
if "%choice%"=="2" (
    start "" "%~dp0เอกสารพนักงาน\01_หนังสือรับรองการทำงาน_นายภาณุพงศ์_ชลเจริญ.html"
    exit /b
)
if "%choice%"=="3" (
    start "" "%~dp0เอกสารพนักงาน\03_สลิปเงินเดือน_นายภาณุพงศ์_ชลเจริญ_พฤศจิกายน2569.html"
    exit /b
)
if "%choice%"=="4" (
    echo กำลังเปิดระบบ Payroll...
    cd /d "%~dp0payroll-app"
    start http://localhost:3001
    npm run dev
    exit /b
)

exit /b
