# ==========================================
# Thai AI Solution - Environment Variables
# ==========================================

# 1. LINE Official Account (LINE Developers Console -> Messaging API)
# Token สำหรับการส่งข้อความตอบกลับ LINE Webhook
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# 2. Google Gemini API Key (สำหรับระบบ AI Assistant & LINE Bot Intelligence)
# ขอรับ API Key ได้ฟรีที่ https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Server Configuration (Optional)
PORT=3000
